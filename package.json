{
  "name": "eparadar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "web": "npm run dev --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "gen:types": "supabase gen types typescript --linked --schema public > apps/mobile/src/lib/database.types.ts",
    "db:test": "supabase test db --local"
  }
}
