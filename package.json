{
  "name": "eparadar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "web": "npm run dev --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "gen:types": "supabase gen types typescript --linked --schema public > apps/mobile/src/lib/database.types.ts",
    "db:test": "supabase test db --local",
    "commit": "cz",
    "commitlint": "commitlint",
    "prepare": "node .husky/install.mjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
