{
  "name": "eparadar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^5.88.1",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "phone": "npm run phone --workspace apps/mobile --",
    "web": "npm run dev --workspace apps/web",
    "check": "npm run lint --workspace apps/mobile && npm run typecheck --workspace apps/mobile && npm run test --workspace apps/mobile -- --runInBand && npm run typecheck --workspace apps/web && knip",
    "format": "prettier --write .",
    "gen:types": "supabase gen types typescript --linked --schema public > apps/mobile/src/lib/database.types.ts",
    "db:test": "supabase test db --local",
    "commit": "cz",
    "commitlint": "commitlint"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
