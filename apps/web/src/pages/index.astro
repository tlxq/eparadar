---
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import heroPhoto from '../assets/park-bokeh.webp';
---

<BaseLayout
  title="epaRadar Kommer Snart"
  description="epaRadar - ett community för oss med EPA: se vilka som är ute live, på kartan och i chatten. Häng med i kön innan lanseringen."
  canonicalPath={SITE.routes.home}
  og={{
    title: 'epaRadar – Kommer snart',
    description: 'Se vilka som är ute, live. Realtid, karta och chatt.',
    imageAlt: 'epaRadar – se vilka som är ute, live på kartan',
  }}
>
  <div class="screen">
    <div class="screen-bg" aria-hidden="true">
      <Image
        src={heroPhoto}
        alt=""
        class="screen-bg-img"
        widths={[640, 960, 1280, 1600, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <Header>
      <div class="domain">eparadar.se</div>
    </Header>

    <div class="content">
      <p class="eyebrow">Kommer snart</p>
      <h1>Kolla vilka som är ute och kör.</h1>
      <p class="subline">Realtid. Karta. Chatt.</p>
      <p class="meta-line">iOS och Android – vintern 2026</p>

      <form id="waitlistForm">
        <div class="field-row">
          <input type="email" name="email" placeholder="din@epost.se" aria-label="E-postadress" required />
          <button class="btn" type="submit">Håll mig uppdaterad</button>
        </div>
        <div class="hp-field" aria-hidden="true">
          <label for="company">Företag</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>
        <p class="consent">Mer information kommer snart</p>
        <p class="form-error" id="formError" role="alert"></p>
        <p class="form-success" id="formSuccess" aria-live="polite"></p>
      </form>
    </div>

    <Footer />
  </div>
</BaseLayout>

<style>
  .screen {
    position: relative;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
  }

  .screen-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .screen-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    animation: kenburns 24s ease-in-out infinite alternate;
  }
  .screen-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 14, 20, 0.5) 0%, rgba(11, 14, 20, 0.82) 50%, rgba(11, 14, 20, 0.95) 100%);
  }
  @keyframes kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen-bg {
      animation: none;
    }
  }

  .domain {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.7s ease-out 0.1s forwards;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .content {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 6px var(--brand);
  }

  h1 {
    font-family: 'Archivo', var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.005em;
    text-wrap: balance;
    margin: 0 0 6px;
    max-width: 15ch;
  }

  .subline {
    font-family: 'Archivo', var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: #d7dce6;
    letter-spacing: 0.02em;
    margin: 0 0 4px;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  }

  .meta-line {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0 0 22px;
  }

  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 380px;
  }
  .field-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }

  input[type='email'] {
    flex: 1 1 200px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    padding: 13px 16px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.95rem;
  }
  input[type='email']::placeholder {
    color: var(--text-secondary);
  }

  .btn {
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border-radius: 10px;
    padding: 13px 20px;
    border: none;
    background: var(--brand);
    color: var(--brand-text);
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 6px 20px -4px rgba(47, 111, 237, 0.55);
    transition: filter 0.15s ease;
  }
  .btn:hover {
    filter: brightness(1.08);
  }
  .btn:disabled {
    opacity: 0.7;
    cursor: default;
    filter: none;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .form-error {
    display: none;
    color: var(--danger);
    font-size: 0.85rem;
    margin: 0;
  }
  .form-error.is-visible {
    display: block;
  }

  .form-success {
    display: none;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .form-success.is-visible {
    display: flex;
  }
</style>

<script is:inline define:vars={{ WAITLIST_ENDPOINT: SITE.api.waitlist }}>
  const form = document.getElementById('waitlistForm');
  const success = document.getElementById('formSuccess');
  const errorEl = document.getElementById('formError');
  const submitBtn = form.querySelector('.btn');
  const submitLabel = submitBtn.textContent;
  let isSubmitting = false;

  function showSuccess() {
    form.querySelectorAll('.field-row').forEach((row) => {
      row.style.display = 'none';
    });
    form.querySelector('.consent').style.display = 'none';
    success.textContent = '✓ Du är med. Vi hör av oss.';
    success.classList.add('is-visible');
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (isSubmitting) return;

    const honeypot = document.getElementById('company').value;
    if (honeypot) return;

    const email = form.querySelector('input[name="email"]').value;

    isSubmitting = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Skickar...';
    errorEl.classList.remove('is-visible');
    errorEl.textContent = '';

    fetch(WAITLIST_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
      signal: AbortSignal.timeout(10000),
    })
      .then(async (response) => {
        if (!response.ok) {
          const body = await response.json().catch(() => null);
          throw new Error(body?.error || 'Request failed');
        }
        showSuccess();
      })
      .catch((err) => {
        if (err && (err.name === 'TimeoutError' || err.name === 'AbortError')) {
          errorEl.textContent = 'Det tog för lång tid att skicka. Kontrollera din uppkoppling och försök igen.';
        } else if (err instanceof Error && err.message && err.message !== 'Request failed') {
          errorEl.textContent = err.message;
        } else {
          errorEl.textContent = 'Något gick fel. Försök igen om en liten stund.';
        }
        errorEl.classList.add('is-visible');
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
        isSubmitting = false;
      });
  });
</script>
