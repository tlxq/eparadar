---
import { Colors } from '@eparadar/theme/colors';
import { SITE, urlFor } from '../config/site';

interface OgProps {
  title: string;
  description: string;
  imageAlt: string;
  image?: string;
}

interface Alternate {
  lang: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  robotsNoindex?: boolean;
  og?: OgProps;
  lang?: string;
  alternates?: Alternate[];
  fontsHref?: string;
  bodyClass?: string;
}

const DEFAULT_FONTS =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Archivo:wght@400;900&display=swap';

const {
  title,
  description,
  canonicalPath,
  robotsNoindex = false,
  og,
  lang = 'sv',
  alternates = [],
  fontsHref = DEFAULT_FONTS,
  bodyClass,
} = Astro.props;
const canonicalUrl = urlFor(canonicalPath);

const theme = Colors.dark;

const cssVars = Object.fromEntries(
  Object.entries(theme).map(([key, value]) => [
    key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`),
    value,
  ])
);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={urlFor(alt.path)} />)}
    {robotsNoindex && <meta name="robots" content="noindex" />}

    {
      og && (
        <>
          <meta property="og:title" content={og.title} />
          <meta property="og:description" content={og.description} />
          <meta property="og:image" content={`${SITE.url}${og.image ?? SITE.ogImage}`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={og.imageAlt} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:type" content="website" />
          <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'sv_SE'} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    <link rel="icon" type="image/svg+xml" href={SITE.favicon} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    <slot name="head" />

    <style is:global define:vars={cssVars}>
      :root {
        --bg: var(--background);
        --gradient-top: var(--gradient-top);
        --bg-element: var(--background-element);
        --bg-selected: var(--background-selected);
        --border: var(--border);
        --text: var(--text);
        --text-secondary: var(--text-secondary);
        --brand: var(--brand);
        --brand-on-surface: var(--brand-on-surface);
        --brand-text: var(--brand-text);
        --accent: var(--accent);
        --success: var(--success);
        --danger: var(--danger);
        --font-display: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-display);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }
    </style>
  </head>

  <body class={bodyClass}>
    <slot />
  </body>
</html>
