---
import { SITE } from '../config/site';
---

<a class="logo" href={SITE.routes.home}>
  <img src={SITE.favicon} alt="" width="40" height="40" />
  <span>epaRadar</span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .logo img {
    display: block;
    border-radius: 10px;
  }
</style>
